# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# Kept deliberately, though nothing writes here right now. The 5 Sep creative
# runs each gave their parallel variant its own dist dir so the two
# servers could not serve each other mixed content; the `distDir` hook in
# next.config.ts is reverted after every run, and this line is what stops the
# next one leaking a build directory into the repo before anyone remembers.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Event source documents: Treasurehunt.docx contains the ANSWERS to every task.
# Never let it reach a public repo or a client bundle (see CLAUDE.md).
# Remove this line only if the repo is private and you have decided that is fine.
docs/

.vercel
.env*

# Worktrees for parallel sessions — three full checkouts of other branches.
# Untracked and NOT ignored until 14 Sep, i.e. one "git add -A" away from
# being committed into the repo they are checkouts of.
.claude/worktrees/
# Audit output from a run with no outDir argument.
.claude/skills/web-verify/undefined/
